# Copy to transform/profiles.yml (gitignored) and fill in your account values.
# No secrets belong in this file -- `private_key_path` points at a key kept
# outside the repo (see infra_snowflake/README.md) and holds no key material
# itself.
merchant_reconciliation:
  target: snowflake
  outputs:
    snowflake:
      type: snowflake
      account: "<org-name>-<account-name>"
      user: "<user>"
      role: RECON_ENGINEERING
      database: MERCHANT_RECON_PROJECT_DEV
      warehouse: TRANSFORM_WH
      schema: SILVER
      private_key_path: "/absolute/path/to/.snowflake/keys/<user>_rsa_key.p8"  # dbt-snowflake does NOT expand ~
      threads: 4
